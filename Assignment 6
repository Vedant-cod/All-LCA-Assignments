import pandas as pd

# Creating a sample DataFrame
data = {
    'Name': ['Amit', 'Rahul', 'Priya', 'Sneha', 'Amit'],
    'Marks': [85, 90, None, 75, 85],
    'City': ['Mumbai', 'Pune', 'Nashik', None, 'Mumbai']
}

df = pd.DataFrame(data)

# Display original DataFrame
print("Original DataFrame:")
print(df)

# Display first 5 records
print("\nFirst 5 Records:")
print(df.head())

# Display information about dataset
print("\nDataset Information:")
print(df.info())

# Display statistical description
print("\nStatistical Description:")
print(df.describe())

# Check missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Fill missing values
df['Marks'] = df['Marks'].fillna(df['Marks'].mean())
df['City'] = df['City'].fillna('Unknown')

print("\nAfter Filling Missing Values:")
print(df)

# Check duplicate records
print("\nDuplicate Records:")
print(df.duplicated())

# Remove duplicate records
df = df.drop_duplicates()

print("\nAfter Removing Duplicates:")
print(df)

# Select specific columns using loc[]
print("\nSelected Data:")
print(df.loc[:, ['Name', 'Marks']])

# Filter students having marks greater than 80
print("\nStudents Having Marks Greater Than 80:")
print(df.loc[df['Marks'] > 80])

# Final DataFrame
print("\nFinal Preprocessed Data:")
print(df)
